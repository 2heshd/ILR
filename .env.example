# Optional: enables username/password accounts and cross-device cloud sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables automatic course-word definition/romanization enrichment,
# adaptive reading/listening passages, and high-quality Persian TTS.
# Keep this server-side. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional: preferred Persian speech provider for flashcards and Listening.
# Use an Iranian Persian voice from your ElevenLabs Voice Library. When both
# values are present, ElevenLabs replaces OpenAI TTS; OpenAI remains the safe
# fallback until setup is complete.
ELEVENLABS_API_KEY=
# Arman — Iranian Persian (male)
ELEVENLABS_VOICE_ID=
# Mina — Iranian Persian (female)
ELEVENLABS_FEMALE_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# Optional sibling tools shown in cross-platform handoffs.
NEXT_PUBLIC_ASL_URL=http://localhost:3000
NEXT_PUBLIC_SYNAPTX_URL=http://localhost:3002
